            "5000000000"
          ],
          "headline_latency_ns": "1000000000",
          "minimum_net_gap_per_contract_e18": "0",
          "leg_skew_buckets_ns": [
            "100000000",
            "1000000000",
            "5000000000",
            "15000000000",
            "60000000000"
          ],
          "audit_intervals": false,
          "profile": null,
          "flags": {
            "version": 1,
            "stale_ms": 5000,
            "settlement_allowlist": [
              "series_moneyline"
            ]
          }
        }
      },
      "checks": [],
      "compare": {
        "rows": "rows",
        "key": [
          "venue",
          "basket_kind",
          "direction",
          "set_id",
          "size_contracts"
