{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "targeter_v2.schema.json",
  "title": "Targeter v2 strategy file",
  "description": "Guide for writing a Targeter v2 strategy file. targeter/v2/registry.py load_strategy is the authority: it also checks cross-references (ids named in scope and ranking.priorities), regex validity and alias collisions, which this schema cannot express. See docs/specs/TARGETER_SELECTION_CONFIG_V1.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sports", "selection", "target_budgets", "polymarket_tags", "market_classes"],
  "properties": {
    "version": {
      "description": "Copied into the selection report as strategy_version. Defaults to 1.",
      "type": "integer",
      "minimum": 1
    },
    "note": {"type": "string"},
    "sports": {
      "description": "Sports discovered from the venue catalogues.",
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "selection": {"$ref": "#/$defs/selection"},
    "scope": {"$ref": "#/$defs/scope"},
    "ranking": {"$ref": "#/$defs/ranking"},
    "target_budgets": {
      "description": "Per-venue subscription-ID budgets. Allocation is bundle-atomic.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kalshi", "polymarket", "limitless"],
      "properties": {
        "kalshi": {"type": "integer", "minimum": 1},
        "polymarket": {"type": "integer", "minimum": 1},
        "limitless": {"type": "integer", "minimum": 1}
      }
    },
    "polymarket_tags": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "limitless_category_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "participant_aliases": {
      "description": "Preferred team identity -> reviewed aliases. Never event-specific fixtures.",
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "known_rule_templates": {
      "type": "array",
      "items": {"type": "string"}
    },
    "market_classes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/market_class"}
    },
    "game_families": {
      "type": "array",
      "items": {"$ref": "#/$defs/game_family"}
    }
  },
  "$defs": {
    "venue": {"enum": ["kalshi", "polymarket", "limitless"]},
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_venues", "preferred_venues", "discovery_horizon_seconds",
        "pre_event_seconds", "run_interval_seconds", "subscription_guard_seconds",
        "event_time_tolerance_seconds", "minimum_market_age_seconds",
        "minimum_combined_moneyline_volume_usd", "post_start_retention_seconds",
        "terminal_clamp_seconds", "continuity_degraded_after_seconds",
        "continuity_hold_enabled", "maximum_bundles"
      ],
      "properties": {
        "minimum_venues": {"type": "integer", "minimum": 2, "maximum": 3},
        "preferred_venues": {
          "description": "minimum_venues <= preferred_venues <= 3.",
          "type": "integer", "minimum": 2, "maximum": 3
        },
        "discovery_horizon_seconds": {"type": "integer", "minimum": 1},
        "pre_event_seconds": {
          "description": "Capture starts this long before activation (shipped: 3600).",
          "type": "integer", "minimum": 1
        },
        "run_interval_seconds": {"type": "integer", "minimum": 1},
        "subscription_guard_seconds": {"type": "integer", "minimum": 1},
        "event_time_tolerance_seconds": {"type": "integer", "minimum": 1},
        "minimum_market_age_seconds": {"type": "integer", "minimum": 1},
        "minimum_combined_moneyline_volume_usd": {
          "description": "Event admission gate on known USD/USDC moneyline volume (shipped: 25000).",
          "type": "number", "exclusiveMinimum": 0
        },
        "post_start_retention_seconds": {"type": "integer", "minimum": 1},
        "terminal_clamp_seconds": {"type": "integer", "minimum": 1},
        "continuity_degraded_after_seconds": {
          "description": "Must be less than terminal_clamp_seconds.",
          "type": "integer", "minimum": 1
        },
        "continuity_hold_enabled": {"type": "boolean"},
        "maximum_bundles": {
          "description": "Most bundles selected per run. The executor requires 1.",
          "type": "integer", "minimum": 1
        },
        "maximum_markets_per_bundle": {
          "description": "Keep at most N markets of each bundle: moneyline anchors first, then market-class priority, activity, target_id. Dropped markets are excluded as market_cap_per_bundle.",
          "type": "integer", "minimum": 1
        },
        "maximum_markets": {
          "description": "Bundle-atomic cap on markets across the whole selection. A bundle that does not fit is skipped as maximum_markets_reached.",
          "type": "integer", "minimum": 1
        }
      }
    },
    "scope": {
      "description": "What may be selected. Out-of-scope bundles and markets stay visible in the report with a reason.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "sports": {
          "description": "Subset of the top-level sports. Other bundles: sport_outside_scope.",
          "type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}
        },
        "games": {
          "description": "game_families ids. Esports bundles of other games: game_outside_scope. Other sports are unaffected.",
          "type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}
        },
        "market_classes": {
          "description": "market_classes ids. Other markets: market_class_outside_scope. Applied after the volume gate, before relationship analysis.",
          "type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}
        }
      }
    },
    "ranking": {
      "description": "How eligible bundles are compared. Lexical: the first key decides, later keys break ties, bundle_id ascending is always last. Absent = venue_coverage desc, cross_venue_relationships desc, market_class_breadth desc, activity desc, activation_time asc.",
      "type": "object",
      "additionalProperties": false,
      "required": ["keys"],
      "properties": {
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "order"],
            "properties": {
              "key": {
                "enum": [
                  "venue_coverage", "cross_venue_relationships", "market_class_breadth",
                  "activity", "moneyline_volume_usd", "activation_time", "game_priority",
                  "market_class_priority_max", "market_class_priority_sum", "venue_set_priority"
                ]
              },
              "order": {"enum": ["asc", "desc"]}
            }
          }
        },
        "priorities": {
          "description": "Config-supplied integer values for the *_priority keys. Required if any *_priority key is used.",
          "type": "object",
          "additionalProperties": false,
          "required": ["default"],
          "properties": {
            "default": {"type": "integer"},
            "game": {
              "description": "game_families id -> priority.",
              "type": "object", "additionalProperties": {"type": "integer"}
            },
            "market_class": {
              "description": "market_classes id -> priority. Also orders markets for maximum_markets_per_bundle.",
              "type": "object", "additionalProperties": {"type": "integer"}
            },
            "venue_set": {
              "description": "Sorted venues joined by '+' -> priority.",
              "type": "object",
              "propertyNames": {
                "enum": ["kalshi+limitless", "kalshi+polymarket", "limitless+polymarket", "kalshi+limitless+polymarket"]
              },
              "additionalProperties": {"type": "integer"}
            }
          }
        }
      }
    },
    "market_class": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sport", "market_type", "scope", "venue_patterns"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sport": {"description": "One of the top-level sports.", "type": "string"},
        "market_type": {"type": "string"},
        "scope": {"type": "string"},
        "venue_patterns": {
          "description": "venue -> vendor field -> regular expressions (case-insensitive search). May be empty only for esports classes mapped by game_families.",
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/venue"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "type": "array", "minItems": 1, "items": {"type": "string"}
            }
          }
        }
      }
    },
    "game_family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sport", "topology", "polymarket_game_tags", "venue_game_aliases", "venue_products"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"},
        "sport": {"const": "esports"},
        "topology": {"const": "best_of_series"},
        "polymarket_game_tags": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}
        },
        "venue_game_aliases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kalshi", "polymarket", "limitless"],
          "properties": {
            "kalshi": {"type": "array", "items": {"type": "string"}},
            "polymarket": {"type": "array", "items": {"type": "string"}},
            "limitless": {"type": "array", "items": {"type": "string"}}
          }
        },
        "venue_products": {
          "description": "venue -> product mappings onto canonical classes. Every venue must be named (an empty array disables it); at least one venue must be non-empty.",
          "type": "object",
          "required": ["kalshi", "polymarket", "limitless"],
          "propertyNames": {"$ref": "#/$defs/venue"},
          "additionalProperties": {
            "type": "array",
            "items": {"$ref": "#/$defs/product_mapping"}
          }
        }
      }
    },
    "product_mapping": {
      "description": "Exactly one of values or patterns. Polymarket patterns must be anchored with ^ and $.",
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "canonical_class"],
      "oneOf": [{"required": ["values"]}, {"required": ["patterns"]}],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "canonical_class": {"description": "A market_classes id.", "type": "string"}
      }
    }
  }
}
