{
  "version": 4,
  "note": "Example: the single best Counter-Strike 2 event, compared by moneyline volume first. A consumer-specific strategy file: venue mapping comes from the catalogue in the Targeter image. Admission gates are identical to the shipped configs/targeter_v2.json.",
  "sports": [
    "soccer",
    "esports"
  ],
  "selection": {
    "minimum_venues": 2,
    "preferred_venues": 3,
    "discovery_horizon_seconds": 172800,
    "pre_event_seconds": 3600,
    "run_interval_seconds": 600,
    "subscription_guard_seconds": 60,
    "event_time_tolerance_seconds": 900,
    "minimum_market_age_seconds": 1800,
    "minimum_combined_moneyline_volume_usd": 25000,
    "post_start_retention_seconds": 21600,
    "terminal_clamp_seconds": 28800,
    "continuity_degraded_after_seconds": 14400,
    "continuity_hold_enabled": true,
    "maximum_bundles": 1,
    "maximum_markets_per_bundle": 6,
    "maximum_markets": 6
  },
  "scope": {
    "sports": [
      "esports"
    ],
    "games": [
      "counter_strike_2"
    ]
  },
  "ranking": {
    "keys": [
      {
        "key": "moneyline_volume_usd",
        "order": "desc"
      },
      {
        "key": "market_class_priority_max",
        "order": "desc"
      },
      {
        "key": "venue_set_priority",
        "order": "desc"
      },
      {
        "key": "activation_time",
        "order": "asc"
      }
    ],
    "priorities": {
      "default": 0,
      "game": {
        "counter_strike_2": 10
      },
      "market_class": {
        "esports.series_moneyline": 5,
        "esports.map_winner": 3
      },
      "venue_set": {
        "kalshi+polymarket": 2,
        "limitless+polymarket": 2,
        "kalshi+limitless": 1,
        "kalshi+limitless+polymarket": 3
      }
    }
  },
  "target_budgets": {
    "kalshi": 1000,
    "polymarket": 400,
    "limitless": 400
  }
}
