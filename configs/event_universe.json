{
  "event_universe_config_version": 1,
  "database_path": "/var/lib/event-universe/event-universe.sqlite3",
  "archive": {
    "bucket": "${ARCHIVE_S3_BUCKET}",
    "region": "${ARCHIVE_S3_REGION}",
    "expected_owner": "${ARCHIVE_S3_EXPECTED_OWNER}"
  },
  "api": {
    "host": "0.0.0.0",
    "port": 8080
  },
  "backfill": {
    "temporary_directory": "/var/lib/event-universe/tmp"
  },
  "backup": {
    "directory": "/var/lib/event-universe/backups",
    "object_prefix": "event-universe/backups"
  }
}
