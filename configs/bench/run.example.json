{
  "version": 1,
  "image": {
    "build_context": "/absolute/<repo-or-worktree>",
    "dockerfile": "docker/replay-runner.Dockerfile",
    "reuse_id": null
  },
  "redis": {
    "image": "redis:8.2-alpine",
    "maxmemory": "150mb"
  },
  "base_run_config": "/absolute/<supervisor-config>.json",
  "context_directory": "/absolute/<prepared-context>",
  "fee_catalog_directory": "/absolute/<fees-output>/<catalog-identity>",
  "mounts": [
    {
      "host": "/absolute/<derivatives>",
      "container": "/bench/in/derivatives"
    }
  ],
  "limits": {
    "attempt_seconds": 3600,
    "run_seconds": 3700,
    "stall_seconds": 120
  },
  "groups": [
    {
      "name": "<group-name>",
      "factory": "<strategy-module>:<factory>",
      "revision": "<reviewed-code-revision>",
      "config": {
        "snapshot_directory": "{context}",
        "snapshot_sha256": "{snapshot_sha256}",
        "fees": {
          "catalog_directory": "{fees}/{catalog_identity}",
          "catalog_identity": "{catalog_identity}"
        },
        "output_directory": "{output}"
      },
      "reader": "<reader-module>:<completed-reader>",
      "checks": [
        "<check-module>:<check-function>"
      ],
      "compare": {
        "rows": "<summary-rows-path>",
        "key": [
          "<row-key-field>"
        ]
      }
    }
  ]
}
