{
  "version": 1,
  "image": {
    "build_context": "/absolute/<repo-or-worktree>",
    "dockerfile": "docker/replay-runner.Dockerfile",
    "reuse_id": null
  },
  "redis": {
    "image": "redis:8.2-alpine",
    "maxmemory": "150mb"
  },
  "base_run_config": "/absolute/<supervisor-config>.json",
  "context_directory": "/absolute/<prepared-context>",
  "fee_catalog_directory": null,
  "mounts": [
    {
      "host": "/absolute/<derivatives>",
      "container": "/bench/in/derivatives"
    }
  ],
  "limits": {
    "attempt_seconds": 3600,
    "run_seconds": 3700,
    "stall_seconds": 120
  },
  "groups": [
    {
      "name": "coverage",
      "factory": "replay.bundle_coverage:build",
      "revision": "<reviewed-code-revision>",
      "config": {
        "version": 1,
        "snapshot_directory": "{context}",
        "snapshot_sha256": "{snapshot_sha256}"
      },
      "reader": "replay.coverage_output:read_completed",
      "checks": [],
      "compare": {
        "rows": "durations",
        "key": [
          "scope",
          "entity"
        ]
      }
    }
  ]
}
