{
	servers {
		max_header_size 32KiB
		timeouts {
			read_body 15s
			read_header 10s
			write 60s
			idle 2m
		}
	}
}

(universe_proxy) {
	reverse_proxy event-universe:8080 {
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 60s
			write_timeout 30s
			keepalive 30s
		}
	}
}

{$REPLAY_PUBLIC_HOST} {
	request_body {
		max_size 64KiB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	# Any browser origin may read the API: the production UI, local and preview
	# builds, and agent-driven browsers. The API is read-only and carries no
	# credentials or cookies, so there is no ambient credential for another origin
	# to use. Caddy answers preflights itself; they never reach Universe.
	header {
		Access-Control-Allow-Origin "*"
	}
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header {
			Access-Control-Allow-Methods "GET"
			Access-Control-Allow-Headers "Content-Type"
			Access-Control-Max-Age "600"
		}
		respond 204
	}

	@api path /v1/* /healthz
	handle @api {
		encode zstd gzip
		import universe_proxy
	}

	# No UI is served here; it is deployed separately and calls /v1 cross-origin.
	handle {
		respond "not found" 404
	}

	log {
		output stdout
		format json
	}
}
