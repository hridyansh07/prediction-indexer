{
	servers {
		max_header_size 32KiB
		timeouts {
			read_body 15s
			read_header 10s
			write 60s
			idle 2m
		}
	}
}

(universe_proxy) {
	reverse_proxy event-universe:8080 {
		transport http {
			dial_timeout 5s
			response_header_timeout 30s
			read_timeout 60s
			write_timeout 30s
			keepalive 30s
		}
	}
}

{$REPLAY_PUBLIC_HOST} {
	request_body {
		max_size 64KiB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}

	# Any browser origin may call the API: the production UI, local and preview
	# builds, and agent-driven browsers. Bearer tokens travel in Authorization,
	# never cookies, so there is no ambient credential for another origin to use;
	# SIWE, the allowlist, and Universe's rate limiter are the controls. Caddy
	# answers preflights itself; they never reach Universe or its rate limiter.
	header {
		Access-Control-Allow-Origin "*"
		Access-Control-Expose-Headers "Retry-After"
	}
	@cors_preflight method OPTIONS
	handle @cors_preflight {
		header {
			Access-Control-Allow-Methods "GET, POST, DELETE"
			Access-Control-Allow-Headers "Authorization, Content-Type, Idempotency-Key"
			Access-Control-Max-Age "600"
		}
		respond 204
	}

	# Authentication responses carry nonces or tokens and are never compressed.
	@auth path /v1/auth/*
	handle @auth {
		import universe_proxy
	}

	@api path /v1/* /healthz
	handle @api {
		encode zstd gzip
		import universe_proxy
	}

	# No UI is served here; it is deployed separately and calls /v1 cross-origin.
	handle {
		respond "not found" 404
	}

	log {
		output stdout
		format json
	}
}
