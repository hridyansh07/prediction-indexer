# Historical data (Oddpool). Only needed for the historical/analysis half.
ODDPOOL_API_KEY=

# Docker Compose deployment.
#
# Use an absolute path on the Linux host for production data. All target files,
# raw spools, and the derived ingest store live below this one durable root.
CAPTURE_DATA_ROOT=./data

# Image identity. Leave IMAGE_REGISTRY empty to build and run locally, which is
# the default and what `docker compose build` on the deployment host produces.
#
# Set it to a registry namespace with a trailing slash — `docker.io/<user>/` or
# `<account>.dkr.ecr.<region>.amazonaws.com/` — when images are built elsewhere
# and pulled here. Images are architecture-specific: an arm64 build from an
# Apple Silicon machine will not start on an x86_64 host, so a cross-built image
# must be produced with `DOCKER_DEFAULT_PLATFORM=linux/amd64`.
#
# Pin IMAGE_TAG to an immutable tag in production. `local` is a moving target
# and makes it impossible to say later which code produced a given archive.
IMAGE_REGISTRY=
IMAGE_TAG=local
PUID=1000
PGID=1000

# Capture/ingest cadence. Defaults are shown explicitly so deployment changes
# are reviewable in one place.
TARGETER_TICK_SECONDS=5
TARGET_POLL_SECONDS=30
SNAPSHOT_POLL_SECONDS=60
FSYNC_INTERVAL_SECONDS=0.25
BACKOFF_MAX_SECONDS=60

# Segment window. Must divide 86400 evenly so windows tile the UTC day. A short
# value is how rotation and recovery are exercised without waiting half an hour.
SEGMENT_SECONDS=1800

# Records buffered between the socket and the writer thread. A full queue applies
# backpressure — it never drops a record and never reconnects the venue. Sized
# from Kalshi's measured steady rate; see docs/SEALED_CAPTURE_PIPELINE_V1.md §4.
WRITER_QUEUE_CAPACITY=20000
INGEST_INTERVAL_SECONDS=5
FINALIZER_INTERVAL_SECONDS=60
FINALIZATION_DEADLINE_SECONDS=300

# Derived ingest-store retention. The ingester rotates between complete sealed
# segments at UTC day boundaries. This one-shot command is intended for a daily
# host cron invocation and never deletes the active `store.db.open` or retained
# receipts. Retention cannot be configured below 24 hours. Audit is the safe
# default; switch to delete only after reviewing its report.
INGEST_STORE_RETENTION_HOURS=24
INGEST_STORE_REAPER_MODE=audit

# Raw archive (Phase 4).
#
# ARCHIVE_BACKEND selects the object store the archiver and reaper write to:
# `local` (default) or `s3`. Both commands read this through the one shared
# factory in archive/store_factory.py; see archive/S3_RAW_ARCHIVE_ADAPTER_V1.md.
#
# local backend (ARCHIVE_BACKEND=local):
#
# ARCHIVE_ROOT must be on *different* storage from CAPTURE_DATA_ROOT for the
# archive to be a second copy rather than a second directory. The default below
# deliberately is not: it exercises the whole path and measures compression
# ratios, and the reaper refuses to delete anything against it.
#
# ARCHIVE_DURABILITY=independent is the declaration that losing the capture host
# does not lose the archive. It is the only setting that produces production
# `archive_receipt_version: 1` receipts, and both commands refuse it when the
# two roots share a filesystem. Raw deletion additionally needs the reaper to be
# run with --delete; see docs/DEPLOYMENT.md. This setting is ignored when
# ARCHIVE_BACKEND=s3 — an S3 backend is always an independent durability domain.
#
# The archiver sweeps on this interval; the archive unit stays one sealed
# 30-minute segment, so a healthy hour publishes two objects per lane and never
# concatenates them.
ARCHIVE_ROOT=./data/archive
ARCHIVE_STORE_ID=local-archive
ARCHIVE_DURABILITY=conformance
ARCHIVER_INTERVAL_SECONDS=3600
REAPER_INTERVAL_SECONDS=3600
# Audit is non-destructive. Set to delete only after the documented verification rollout.
REAPER_MODE=audit
# Canonical frames have their own receipt-proved deletion authority. The floor
# cannot be set below 18 hours; both small receipts remain after deletion.
CANONICAL_REAPER_INTERVAL_SECONDS=3600
CANONICAL_REAPER_RETENTION_HOURS=18
CANONICAL_REAPER_MODE=audit
ARCHIVE_BACKEND=local

# s3 backend (ARCHIVE_BACKEND=s3). All three are required together; the
# archiver and reaper refuse to start with only some of them set, and refuse
# to start if any of them is set while ARCHIVE_BACKEND is still `local` — that
# combination almost always means ARCHIVE_BACKEND was left unset by mistake.
# ARCHIVE_S3_EXPECTED_OWNER is the bucket-owning account's 12-digit AWS
# account id, sent as ExpectedBucketOwner on every S3 request. Credentials are
# never set here: prefer an instance/task role. For a Compose host using AWS
# environment credentials, export AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and
# (for temporary credentials) AWS_SESSION_TOKEN in the invoking shell; Compose
# forwards them only to the S3-facing archive services. Host shared-config files
# are not mounted into the containers.
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_REGION=
ARCHIVE_S3_EXPECTED_OWNER=

# Event Universe is deployed independently with compose.universe.yaml. Its
# database and bounded temporary control extraction live on this persistent
# volume; it never mounts CAPTURE_DATA_ROOT or the local archive receipt tree.
EVENT_UNIVERSE_DATA_ROOT=./data/event-universe
EVENT_UNIVERSE_BIND_ADDRESS=127.0.0.1
EVENT_UNIVERSE_PORT=8080

# Targeter v2 production publishing. This is consumed only when
# compose.targeter-v2.yaml is explicitly included. Production should remain S3;
# `local` is useful only for conformance/archive probes and cannot publish unless
# the local archive is independently mounted and declared as such.
TARGETER_ARCHIVE_BACKEND=s3

# Targeter v2 run-directory retention. Each scheduled run leaves a 12-20 MB
# directory under targeter-v2-runs; at the documented ten-minute cadence that is
# roughly 2 GB/day and nothing else removes it.
#
# targeter-v2-run-archiver archives every complete run that holds no receipt yet.
# It never deletes. targeter-v2-run-reaper deletes local run artifacts only when
# the production receipt reverifies against an independent store, the run is not
# the published generation, and it is older than the floor below. The receipt
# stays behind as a tombstone; run archives and generations are never touched.
#
# Audit is non-destructive and is the default. Set delete only after the
# documented verification rollout, and only with an independent backend.
TARGETER_RUN_REAPER_MODE=audit
# Hours a run directory is retained unconditionally. 18 is the floor; the
# command refuses a smaller value. At the ten-minute cadence this keeps roughly
# 108 runs, about 1.3-2.2 GB.
TARGETER_RUN_RETENTION_HOURS=18

# Kalshi live capture.
#
# Kalshi is the only venue that authenticates market data, and it authenticates
# every connection — orderbook_delta is a private channel and the WebSocket
# handshake itself is signed. Without these the Kalshi splice cannot connect;
# every other component in this repo runs without them, including the Kalshi
# targeter, which uses the public market catalogue.
#
# Create an API key in the Kalshi UI. You get a key id, and the private key PEM
# downloads once. Set the id here and point at the PEM. Compose mounts this host
# path read-only at /run/secrets/kalshi-private-key.pem; use an absolute host path
# on the deployment machine.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Alternative for direct/local runs (the Compose profile deliberately uses the
# read-only file mount above). Escaped \n is handled:
# KALSHI_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----"
