{
  "name": "prediction-indexer-workspace",
  "private": true,
  "packageManager": "yarn@1.22.19",
  "workspaces": [
    "targeter-ui"
  ],
  "scripts": {
    "build": "yarn workspace prediction-indexer-targeter-ui build",
    "format": "prettier --write package.json vercel.json eslint.config.mjs targeter-ui",
    "lint": "prettier --check package.json vercel.json eslint.config.mjs targeter-ui && eslint targeter-ui",
    "lint:fix": "prettier --write package.json vercel.json eslint.config.mjs targeter-ui && eslint targeter-ui --fix",
    "typecheck": "yarn workspaces run typecheck",
    "test": "yarn workspaces run test"
  },
  "devDependencies": {
    "@eslint/js": "9.33.0",
    "@types/node": "^22.17.1",
    "eslint": "9.33.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.39.0"
  }
}
