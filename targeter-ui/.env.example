# Server-side Event Universe API integration. The browser uses only the
# same-origin /api/event-universe proxy. Do not prefix these with VITE_.
UNIVERSE_API_BASE_URL=https://event-universe.internal.example
UNIVERSE_API_TIMEOUT_MS=5000
UNIVERSE_API_MAX_RESPONSE_BYTES=1750000

# Optional complete Authorization header for a network proxy in front of Event
# Universe. Keep the real value in server/orb/Vercel secrets.
# UNIVERSE_API_AUTHORIZATION=Bearer replace-with-server-side-secret

PORT=3000
