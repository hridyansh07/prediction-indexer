# Amp OIDC token minting. The audience must match the client ID configured on
# the AWS IAM OIDC provider. AWS_WEB_IDENTITY_TOKEN_FILE is derived from the
# repository root by the orb services and is not project configuration.
AWS_OIDC_AUDIENCE=sts.amazonaws.com

# AWS SDK web-identity role assumption. Replace the account ID and role name.
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/prediction-indexer-targeter-ui
AWS_ROLE_SESSION_NAME=prediction-indexer-targeter-ui
AWS_REGION=us-east-1
AWS_STS_REGIONAL_ENDPOINTS=regional

# Targeter UI archive access. The expected owner is the bucket owner's 12-digit
# AWS account ID, not the role ID.
TARGETER_UI_S3_BUCKET=prediction-indexer-archive-example
TARGETER_UI_AWS_REGION=us-east-1
TARGETER_UI_S3_EXPECTED_OWNER=123456789012
TARGETER_UI_S3_PREFIX=targeter-v2/runs
TARGETER_UI_DECODER_PATH=/workspace/encoder/rust/target/release/prediction-decode-v1

# Refresh and health heuristics.
TARGETER_UI_REFRESH_SECONDS=60
TARGETER_UI_EXPECTED_RUN_SECONDS=600
TARGETER_UI_MAX_RUNS=5

# Optional historical Event Universe integration. The URL must be reachable by
# the server; browsers use only the same-origin /api/event-universe proxy.
TARGETER_UI_EVENT_UNIVERSE_URL=https://event-universe.internal.example
TARGETER_UI_EVENT_UNIVERSE_TIMEOUT_MS=5000
TARGETER_UI_EVENT_UNIVERSE_MAX_RESPONSE_BYTES=2097152

# Optional complete Authorization header for a network proxy in front of Event
# Universe. Keep the real value in server/orb secrets; it is never sent to the
# browser. Omit this variable when the colocated Universe API has no auth.
TARGETER_UI_EVENT_UNIVERSE_AUTHORIZATION=Bearer replace-with-server-side-secret

PORT=3000
