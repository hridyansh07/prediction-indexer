#!/usr/bin/env bash
set -euo pipefail

: "${AWS_OIDC_AUDIENCE:?AWS_OIDC_AUDIENCE is required}"

REPO_ROOT="$(git rev-parse --show-toplevel)"
export AWS_WEB_IDENTITY_TOKEN_FILE="$REPO_ROOT/.amp/runtime/aws-oidc-token"

umask 077
token_directory="$(dirname "$AWS_WEB_IDENTITY_TOKEN_FILE")"
install -d -m 0700 "$token_directory"

tmp="$(mktemp "${AWS_WEB_IDENTITY_TOKEN_FILE}.tmp.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

amp orb id-token \
  --audience "$AWS_OIDC_AUDIENCE" \
  --ttl-seconds 3600 > "$tmp"

test -s "$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$AWS_WEB_IDENTITY_TOKEN_FILE"
trap - EXIT
