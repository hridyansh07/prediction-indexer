# Archive-only reference. Runtime Compose reads the repository-root .env.
ARCHIVE_BACKEND=local
ARCHIVE_ROOT=/var/lib/prediction-archive
ARCHIVE_DURABILITY=conformance
ARCHIVE_STORE_ID=local-archive
ARCHIVE_S3_BUCKET=
ARCHIVE_S3_REGION=
ARCHIVE_S3_EXPECTED_OWNER=
ARCHIVE_GCS_BUCKET=
ARCHIVER_INTERVAL_SECONDS=3600
REAPER_INTERVAL_SECONDS=3600
REAPER_MODE=audit
CANONICAL_REAPER_INTERVAL_SECONDS=3600
CANONICAL_REAPER_RETENTION_HOURS=18
CANONICAL_REAPER_MODE=audit

# Never store AWS or GCP credentials here. Use boto3's standard credential
# chain for S3 or Application Default Credentials for GCS; a workload role or
# attached service account is preferred for production.
