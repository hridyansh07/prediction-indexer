#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
export AWS_WEB_IDENTITY_TOKEN_FILE="$REPO_ROOT/.amp/runtime/aws-oidc-token"
install -d -m 0700 "$(dirname "$AWS_WEB_IDENTITY_TOKEN_FILE")"

if ! command -v docker >/dev/null 2>&1; then
	sudo install -m 0755 -d /etc/apt/keyrings
	sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
	sudo chmod a+r /etc/apt/keyrings/docker.asc
	echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
	sudo apt-get update
	sudo apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
fi

if ! command -v cargo >/dev/null 2>&1 && [ ! -x "$HOME/.cargo/bin/cargo" ]; then
	curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
		| sh -s -- -y --profile minimal --default-toolchain 1.85.0
fi
RUSTUP_BIN="$(command -v rustup || printf '%s' "$HOME/.cargo/bin/rustup")"
"$RUSTUP_BIN" component add --toolchain 1.85.0 rustfmt clippy

yarn install --frozen-lockfile
yarn build:packages
CARGO_BIN="$(command -v cargo || printf '%s' "$HOME/.cargo/bin/cargo")"
"$CARGO_BIN" build --release \
	--manifest-path encoder/rust/Cargo.toml \
	--bin prediction-decode-v1
git config core.hooksPath .githooks
