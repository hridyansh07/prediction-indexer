#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
REDIS_VERSION="8.2.10"
REDIS_SHA256="d33935732f7fc15476295fe05f5ce740927bc14847798e47b3f67b4f27b8b478"
REDIS_PREFIX="$HOME/.local/redis-$REDIS_VERSION"

if ! command -v docker >/dev/null 2>&1 || ! docker compose version >/dev/null 2>&1; then
	if [ ! -f /etc/apt/sources.list.d/docker.list ]; then
		sudo install -m 0755 -d /etc/apt/keyrings
		sudo curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
		sudo chmod a+r /etc/apt/keyrings/docker.asc
		echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/debian $(. /etc/os-release && echo "$VERSION_CODENAME") stable" | sudo tee /etc/apt/sources.list.d/docker.list > /dev/null
	fi
	sudo apt-get update
	if command -v docker >/dev/null 2>&1; then
		sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y docker-compose-plugin
	else
		sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
	fi
fi
docker compose version

if [[ ! -x "$REDIS_PREFIX/bin/redis-server" ]] \
	|| [[ "$($REDIS_PREFIX/bin/redis-server --version 2>/dev/null)" != *"v=$REDIS_VERSION "* ]]; then
	(
		build_root="$(mktemp -d)"
		trap 'rm -rf "$build_root"' EXIT
		tarball="$build_root/redis-$REDIS_VERSION.tar.gz"
		# Official Redis release tarball, authenticated by the SHA-256 published in
		# redis/redis-hashes. This adds no package repository or signing key.
		curl --proto '=https' --tlsv1.2 -fsSL \
			"https://download.redis.io/releases/redis-$REDIS_VERSION.tar.gz" \
			-o "$tarball"
		printf '%s  %s\n' "$REDIS_SHA256" "$tarball" | sha256sum --check --status
		tar -xzf "$tarball" -C "$build_root"
		make -C "$build_root/redis-$REDIS_VERSION" -j"$(nproc)" \
			BUILD_WITH_MODULES=no MALLOC=libc
		make -C "$build_root/redis-$REDIS_VERSION" \
			BUILD_WITH_MODULES=no MALLOC=libc PREFIX="$build_root/install" install
		rm -rf "$REDIS_PREFIX"
		install -d "$(dirname "$REDIS_PREFIX")"
		mv "$build_root/install" "$REDIS_PREFIX"
	)
fi
install -d "$HOME/.local/bin"
ln -sfn "$REDIS_PREFIX/bin/redis-server" "$HOME/.local/bin/redis-server"
ln -sfn "$REDIS_PREFIX/bin/redis-cli" "$HOME/.local/bin/redis-cli"
redis-server --version | grep -F "v=$REDIS_VERSION "

if ! command -v cargo >/dev/null 2>&1 && [ ! -x "$HOME/.cargo/bin/cargo" ]; then
	curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
		| sh -s -- -y --profile minimal --default-toolchain 1.85.0
fi
RUSTUP_BIN="$(command -v rustup || printf '%s' "$HOME/.cargo/bin/rustup")"
"$RUSTUP_BIN" component add --toolchain 1.85.0 rustfmt clippy

if [ ! -x "$REPO_ROOT/.venv/bin/python" ]; then
	python3 -m venv "$REPO_ROOT/.venv"
fi
"$REPO_ROOT/.venv/bin/python" -m pip install -e "$REPO_ROOT[replay-redis]"

yarn install --frozen-lockfile
yarn build:packages
git config core.hooksPath .githooks
